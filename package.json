{
  "name": "magnolia-tauri-app",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "node ./scripts/run_tauri.mjs",
    "tauri:dev": "node ./scripts/run_tauri.mjs dev",
    "tauri:build": "node ./scripts/run_tauri.mjs build",
    "setup:libs": "node ./scripts/setup_runtime_libs.mjs",
    "setup:libs:mac:intel": "MPV_TARGET_ARCH=x86_64 node ./scripts/setup_runtime_libs.mjs --platform darwin",
    "sync:runtime": "node ./scripts/sync_runtime_libs.mjs",
    "sync:runtime:mac": "node ./scripts/sync_runtime_libs.mjs --platform darwin",
    "sync:runtime:linux": "node ./scripts/sync_runtime_libs.mjs --platform linux",
    "sync:runtime:win": "node ./scripts/sync_runtime_libs.mjs --platform win32"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.0.0",
    "svelte": "^5.55.7",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "geist": "^1.7.1",
    "remixicon": "^4.7.0"
  }
}
